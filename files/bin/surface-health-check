#!/usr/bin/env bash
#
# surface-health-check — verify the fragile parts of a Surface Book 2 setup
# on Omarchy after an update.
#
#   surface-health-check          full output
#   surface-health-check --quiet  problems only
#   surface-health-check --hook   terse, for the pacman hook
#
# Exit code: 0 = fine, 1 = at least one problem.
# In --hook mode always 0, so an update can never fail because of this.
#
# Run as root for the full picture: /boot is not readable by normal users on
# Omarchy, so checks 2 and 3 need it.
#
# Part of https://github.com/<you>/surface-book-2-omarchy — MIT licensed.

MODE="${1:-}"
LIMINE_CONF="${LIMINE_CONF:-/boot/limine.conf}"
BOOT_MIN_MB="${BOOT_MIN_MB:-400}"
PROBLEMS=0

c_red=$'\033[1;31m'; c_yel=$'\033[1;33m'; c_grn=$'\033[1;32m'; c_off=$'\033[0m'

# Note: never name a shell function after a real command. A function called
# `head` here would shadow /usr/bin/head and silently break every `| head -1`
# in this file. That bug cost an hour.
section() { [ "$MODE" = "--hook" ] || printf '\n%s\n' "$1"; }
good()    { [ "$MODE" = "--quiet" ] || [ "$MODE" = "--hook" ] || printf '  %sOK%s    %s\n' "$c_grn" "$c_off" "$1"; }
warn()    { printf '  %sWARN%s  %s\n' "$c_yel" "$c_off" "$1"; PROBLEMS=$((PROBLEMS+1)); }
bad()     { printf '  %sFAIL%s  %s\n' "$c_red" "$c_off" "$1"; PROBLEMS=$((PROBLEMS+1)); }
info()    { [ "$MODE" = "--quiet" ] || [ "$MODE" = "--hook" ] || printf '        %s\n' "$1"; }

[ "$MODE" = "--hook" ] && printf 'Surface: checking boot configuration ...\n'

# Installed kernels, by module directory. "6.19.8-arch1-3-surface" -> "surface"
# is not reliable, so we key on the package names Limine uses instead.
KERNELS=""
for d in /usr/lib/modules/*/; do
    [ -e "${d}pkgbase" ] && KERNELS="$KERNELS $(cat "${d}pkgbase")"
done
KERNELS="$(printf '%s\n' $KERNELS | sort -u)"

# --- 1. Space on /boot -----------------------------------------------------
section "1. Space on /boot"
FREE_MB=$(df -Pm /boot 2>/dev/null | awk 'NR==2{print $4}')
USED=$(df -h /boot 2>/dev/null | awk 'NR==2{print $3" of "$2}')
if [ -z "$FREE_MB" ]; then
    bad "/boot not readable"
elif [ "$FREE_MB" -lt "$BOOT_MIN_MB" ]; then
    bad "only ${FREE_MB} MB free on /boot (used: $USED)"
    info "Each unified kernel image is ~150 MB, and every snapshot keeps a copy."
    info "Clean up old snapshots:"
    info "  sudo snapper -c root list"
    info "  sudo snapper -c root delete <number>"
else
    good "${FREE_MB} MB free on /boot (used: $USED)"
fi

# --- 2. Boot menu entries --------------------------------------------------
section "2. Entries in $LIMINE_CONF"
if [ ! -r "$LIMINE_CONF" ]; then
    bad "$LIMINE_CONF not readable (run as root)"
else
    for k in $KERNELS; do
        if grep -qE "^[[:space:]]*//${k}[[:space:]]*$" "$LIMINE_CONF"; then
            good "entry //${k} present"
        else
            bad "entry //${k} MISSING from the boot menu"
            info "Regenerate with:  sudo limine-update"
        fi
    done

    # Without these the encrypted root will not boot. Check every cmdline,
    # not just the first: a snapshot entry with a broken cmdline is a trap
    # you only find when you need it.
    for p in cryptdevice= 'rootflags=subvol='; do
        if ! grep -qE '^[[:space:]]*cmdline:' "$LIMINE_CONF"; then
            info "no cmdline lines found, skipping '$p'"
            continue
        fi
        miss=0
        while IFS= read -r line; do
            case "$line" in *"$p"*) ;; *) miss=1 ;; esac
        done < <(grep -E '^[[:space:]]*cmdline:' "$LIMINE_CONF")
        if [ "$miss" = "0" ]; then
            good "every cmdline contains '$p'"
        else
            bad "at least one cmdline is missing '$p'"
            info "An entry without it will not unlock your encrypted root."
        fi
    done
fi

# --- 3. Kernel images ------------------------------------------------------
section "3. Kernel images in /boot/EFI/Linux"
if [ -d /boot/EFI/Linux ]; then
    for k in $KERNELS; do
        f=$(ls /boot/EFI/Linux/*"${k}"*.efi 2>/dev/null | head -1)
        if [ -n "$f" ]; then
            good "$(basename "$f") ($(du -h "$f" | cut -f1))"
        else
            bad "no image found for $k"
        fi
    done
elif ls /boot/vmlinuz-* >/dev/null 2>&1; then
    info "not using unified kernel images; found:"
    ls /boot/vmlinuz-* | while read -r f; do info "  $(basename "$f")"; done
else
    bad "neither /boot/EFI/Linux nor /boot/vmlinuz-* found"
fi

# --- 4. Does the firmware still start Limine? ------------------------------
section "4. EFI boot order"
if command -v efibootmgr >/dev/null && efibootmgr >/dev/null 2>&1; then
    order=$(efibootmgr | awk -F': ' '/^BootOrder/{print $2}')
    first=${order%%,*}
    label=$(efibootmgr | grep -E "^Boot${first}\*?" | sed 's/^Boot[0-9A-Fa-f]*\*\? //' | cut -c1-40)
    case "$label" in
        Limine*) good "Limine boots first (Boot$first)" ;;
        *)       warn "first boot entry is '$label', not Limine"
                 info "Edits to limine.conf will have no effect while this is true."
                 info "Fix with:  sudo efibootmgr -o <limine-number>,$order" ;;
    esac
else
    info "efibootmgr not usable (run as root)"
fi

# --- 5. DKMS modules for every kernel --------------------------------------
section "5. DKMS modules"
if command -v dkms >/dev/null && [ -n "$(dkms status 2>/dev/null)" ]; then
    for d in /usr/lib/modules/*/; do
        kver="$(basename "$d")"
        [ -e "${d}pkgbase" ] || continue
        if dkms status 2>/dev/null | grep -q "$kver"; then
            good "DKMS modules built for $kver"
        else
            warn "no DKMS modules for $kver"
            info "Anything depending on them (e.g. the NVIDIA driver) will be absent"
            info "when you boot that kernel."
        fi
    done
else
    info "no DKMS modules installed"
fi

# --- 6. Services -----------------------------------------------------------
section "6. Services"
for s in surface-dtx-daemon.service iio-sensor-proxy.service; do
    if systemctl list-unit-files "$s" >/dev/null 2>&1 && \
       systemctl list-unit-files "$s" 2>/dev/null | grep -q "$s"; then
        st=$(systemctl is-active "$s" 2>/dev/null)
        [ "$st" = "active" ] && good "$s active" || warn "$s is '$st'"
    else
        info "$s not installed"
    fi
done

case "$(uname -r)" in
    *surface*)
        u=$(systemctl list-units --type=service --state=active --no-legend 'iptsd@*' 2>/dev/null \
            | grep -oE 'iptsd@[^[:space:]]+\.service' | head -1)
        if [ -n "$u" ]; then
            good "$u active (touchscreen)"
        else
            bad "iptsd is not running — no touchscreen"
            info "Start it with:  sudo systemctl start iptsd@dev-hidraw<N>.service"
            info "Find <N> with:  grep -l IPTS /sys/class/hidraw/*/device/uevent"
        fi
        ;;
    *)
        info "not on the linux-surface kernel — no touchscreen here, as expected"
        ;;
esac

# --- 7. Running kernel -----------------------------------------------------
section "7. Running kernel"
info "$(uname -r)"

# --- Result ----------------------------------------------------------------
if [ "$MODE" = "--hook" ]; then
    if [ "$PROBLEMS" -gt 0 ]; then
        printf '%sSurface: %d issue(s). Check with:  sudo surface-health-check%s\n' \
               "$c_yel" "$PROBLEMS" "$c_off"
    else
        printf 'Surface: boot configuration still fine.\n'
    fi
    exit 0
fi

echo
if [ "$PROBLEMS" -eq 0 ]; then
    printf '%sAll good.%s\n' "$c_grn" "$c_off"
    exit 0
else
    printf '%s%d item(s) need attention.%s\n' "$c_yel" "$PROBLEMS" "$c_off"
    exit 1
fi
